rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if (request.auth != null && request.auth.uid == userId && 
                       (!request.resource.data.keys().hasAny(['betaApproved']) || 
                        (resource != null && 'betaApproved' in resource.data && request.resource.data.betaApproved == resource.data.betaApproved))
                      ) || 
                      (request.resource.data.systemSecret == "SendStreakBackendSecretToken2026!");
      
      match /{document=**} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if (request.auth != null && request.auth.uid == userId && 
                         (!request.resource.data.keys().hasAny(['betaApproved']) || 
                          (resource != null && 'betaApproved' in resource.data && request.resource.data.betaApproved == resource.data.betaApproved))
                        ) || 
                        (request.resource.data.systemSecret == "SendStreakBackendSecretToken2026!");
      }
    }

    match /global_stats/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
